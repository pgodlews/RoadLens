# Local SAM 3.1 checkpoint
ROADLENS_SAM_CHECKPOINT=/path/to/sam3.1_multiplex.pt

# Optional remote OpenAI-compatible VLM (falls back to MODEL_API_KEY)
ROADLENS_VLM_API_URL=
ROADLENS_VLM_MODEL=
ROADLENS_VLM_API_KEY=

# Required only for the remote Meta Model API backend
MODEL_API_KEY=

# Local OpenStreetMap tile endpoint (used by the review UI)
ROADLENS_OSM_TILE_URL=http://nuc3:8090/tile/{z}/{x}/{y}.png
