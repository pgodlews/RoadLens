# Local SAM 3.1 checkpoint
ROADLENS_SAM_CHECKPOINT=/path/to/sam3.1_multiplex.pt

# Optional remote VLM. Defaults to the Meta Model API (https://api.meta.ai/v1)
# with muse-spark-1.3 and MODEL_API_KEY; override for another
# OpenAI-compatible endpoint.
ROADLENS_VLM_API_URL=
ROADLENS_VLM_MODEL=
ROADLENS_VLM_API_KEY=
# Muse Spark reasons before answering; tokens reserved on top of the answer
# (default 8000) and optional reasoning_effort (low/medium/high).
ROADLENS_VLM_REASONING_TOKENS=
ROADLENS_VLM_REASONING_EFFORT=

# Meta Model API key: hosted SAM 3.1 (--backend remote) and remote triage
MODEL_API_KEY=
# Hosted SAM tracks at most 16 objects per session, so longer clips are sent
# as overlapping chunks of this many frames (default 200).
ROADLENS_REMOTE_CHUNK_FRAMES=

# Local OpenStreetMap PMTiles archive for maps and offline street lookup
ROADLENS_PMTILES=/path/to/united-kingdom.pmtiles
